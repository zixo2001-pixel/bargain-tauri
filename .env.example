# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD_WEBHOOK_URL: (Optional) Discord Webhook URL for character bargain alerts.
# Can also be configured directly in the app UI.
DISCORD_WEBHOOK_URL=""

# TAURI_SESSION_COOKIE: Tauri session cookie value. Sent server-side as 'tSessionId=<value>'.
# Kept strictly server-side for authenticated character AH queries.
TAURI_SESSION_COOKIE=""

# TAURI_AH_URL: Target URL to TauriWoW character AH endpoint. Defaults to https://tauriwow.com/vipdsh/ajax/characterah
TAURI_AH_URL="https://tauriwow.com/vipdsh/ajax/characterah"

# POLLING_INTERVAL_MINUTES: (Optional) Polling interval in minutes. Defaults to 5.
POLLING_INTERVAL_MINUTES=5

# DATA_DIR or RAILWAY_VOLUME_MOUNT_PATH: (Optional) Path to persistent volume storage directory.
# On Railway, attach a volume at /data and set DATA_DIR=/data
DATA_DIR="/data"
RAILWAY_VOLUME_MOUNT_PATH="/data"

# PORT: Server port (Railway injects this automatically).
PORT=3000
